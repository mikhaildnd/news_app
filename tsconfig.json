{
  "compilerOptions": {
    "noEmit": true, // чтобы не компилировались .js и .d.ts файлы при tsc --build
    "outDir": "./dist/",
    "noImplicitAny": true,
    "target": "ESNext",
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node", "vite/client", "vite-plugin-svgr/client"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS",
    }
  },
  "exclude": ["node_modules", "dist"],
  "include": [
    "src/**/*",
    "cypress/**/*",
    "config/**/*",
    "scripts/**/*"
  ],
  "files": [
    "src/app/types/global.d.ts",
    "src/app/types/vite-env.d.ts"
  ]
}
